{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Communication AI Event",
  "type": "object",
  "required": [
    "id",
    "status",
    "title",
    "confirmed",
    "tbd"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "QA_FAILED",
        "QA_PASSED",
        "APPROVED",
        "PUBLISHED"
      ]
    },
    "title": {
      "type": "string"
    },
    "confirmed": {
      "type": "object",
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "weekday": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "tbd": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "draft_approved": {
          "type": "boolean"
        },
        "publication_authorized": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}